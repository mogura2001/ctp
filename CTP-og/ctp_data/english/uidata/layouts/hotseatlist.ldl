		int	srcheightpix	204
		header {
			switch0:T_FONT1_16 {
				int	widthpix	100
				int	heightpix	20
				string text "str_ldl_Civilization"
				string	pattern	"upba5605.tga"
				int bevelwidth 	1
			}
			switch1:T_FONT1_16 {
				int	widthpix	100
				int	heightpix	20
				string text "str_ldl_Player_Type"
				string	pattern	"upba5605.tga"
				int bevelwidth 	1
			}
			switch2:T_FONT1_16 {
				int widthpix 150
				int heightpix 20
				string text "str_ldl_Player_Name"
				string pattern "upba5605.tga"
				int bevelwidth 1
			}
			switch3:T_FONT1_16 {
				int widthpix 260
				int heightpix 20
				string text "str_ldl_Email_Address"
				string pattern "upba5605.tga"
				int bevelwidth 1
			}
		}
	}
}

