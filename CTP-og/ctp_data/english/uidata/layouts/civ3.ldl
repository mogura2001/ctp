# Civ Mouse


CivMouse {
	# for telling the mouse you will eventually have more
	# cursors than what's listed here.
	int numcursors 64
		
	string cursor0	"cursor0.tga"
	int	 hotspotx0	0
	int	 hotspoty0	0


	string cursor1	"cursor1.tga"
	int	 hotspotx1	0
	int	 hotspoty1	0


	string cursor2	"cursor2.tga"
	int	 hotspotx2	0
	int	 hotspoty2	0


	string cursor3	"cursor1.tga"
	int	 hotspotx3	0
	int	 hotspoty3	0


	string cursor4	"UC001.tga"
	int	hotspotx4	16
	int hotspoty4	16


	string cursor5	"UC002.tga"
	int	hotspotx5	16
	int hotspoty5	16


	string cursor6	"UC003.tga"
	int	hotspotx6	16
	int hotspoty6	16


	string cursor7	"UC004.tga"
	int	hotspotx7	16
	int hotspoty7	16


	string cursor8	"UC005.tga"
	int	hotspotx8	16
	int hotspoty8	16


	string cursor9	"UC006.tga"
	int	hotspotx9	16
	int hotspoty9	16


	string cursor10	"UC007.tga"
	int	hotspotx10	16
	int hotspoty10	16


	string cursor11	"UC008.tga"
	int	hotspotx11	16
	int hotspoty11	16


	string cursor12	"UC009.tga"
	int	hotspotx12	16
	int hotspoty12	16


	string cursor13	"UC010.tga"
	int	hotspotx13	16
	int hotspoty13	16


	string cursor14	"UC011.tga"
	int	hotspotx14	16
	int hotspoty14	16


	string cursor15	"UC012.tga"
	int	hotspotx15	16
	int hotspoty15	16


	string cursor16	"UC013.tga"
	int	hotspotx16	16
	int hotspoty16	16


	string cursor17	"UC014.tga"
	int	hotspotx17	16
	int hotspoty17	16


	string cursor18	"UC015.tga"
	int	hotspotx18	16
	int hotspoty18	16


	string cursor19	"UC016.tga"
	int	hotspotx19	16
	int hotspoty19	16

	string	cursor20	"UC029.tga"
	int		hotspotx20	13
	int		hotspoty20	13

	string	cursor21	"UC030.tga"
	int		hotspotx21	13
	int		hotspoty21	13

	# number of miliseconds between animation frames.
	int	animdelay	200


	int	firstindex	0
	int	lastindex	3
	
	# default cursor
	anim0 {
		int	animdelay	200
		
		int	firstindex	0
		int	lastindex	3
	}


	# Assault	
	anim1 {
		int animdelay 	200
		int firstindex	4
		int lastindex	6
	}
	
	# Bombard
	anim2 {
		int animdelay 	200
		int firstindex	7
		int lastindex	9
	}
	
	# No Move
	anim3 {
		int animdelay 	200
		int firstindex	10
		int lastindex	12
	}
	
	# Move
	anim4 {
		int animdelay 	200
		int firstindex	13
		int lastindex	15
	}
	
	# Selection
	anim5 {
		int animdelay 	200
		int firstindex	16
		int lastindex	18
	}


	# Special Action
	anim6 {
		int animdelay 	200
		int firstindex	19
		int lastindex	19
	}
	
	# Zoom In
	anim7 {
		int animdelay	200
		int firstindex	20
		int lastindex	20
	}

	# Zoom Out
	anim8 {
		int animdelay	200
		int firstindex	21
		int lastindex	21
	}

# now you can do the same for anim1, anim2, etc. and use
# aui_Mouse::SetAnim( animNum ) in your code instead of
# aui_Mouse::SetIndexes/AnimDelay().
}


