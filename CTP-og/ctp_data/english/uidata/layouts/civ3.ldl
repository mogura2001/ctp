	mytabgroup {
		string	xanchor	"left"
		string	yanchor	"bottom"
		int	xpix	10
		int	ypix	10
		int	widthpct	50
		int	heightpct	50
		sadtab {
			string	parent	"mywindow"
			int	heightpct	5
			string	pattern	"patternd.tga"
			string	text	"str_ldl_Sad"
			pane {
				string	parent	"mywindow"
				int	widthpct	50
				int	heightpct	45
				checkbox {
					int	xpix	50
					int	ypix	50
					int	widthpix	150
					int	heightpix	30
					string	pattern	"upba3010.t"
					string	text	"str_ldl_Add_Tab"
				}
				dragcheckbox {
					int	xpix	50
					int	ypix	90
					int	widthpix	150
					int	heightpix	30
					string	pattern	"upba3010.tga"
					string	text	"str_ldl_Make_Draggable"
				}
				transparentcheckbox {
					int	xpix	50
					int	ypix	130
					int	widthpix	150
					int	heightpix	30
					string	pattern	"upba3010.tga"
					string	text	"str_ldl_Make_Transparent"
				}
			}
		}
		indifferenttab {
			string	parent	"mywindow"
			int	heightpct	5
			string	pattern	"upba3010.tga"
			string	text	"str_ldl_Indifferent"
			pane {
				string	parent	"mywindow"
				int	widthpct	50
				int	heightpct	45
				modalradiogroup {
					string	xanchor	"center"
					string	yanchor	"center"
					int	widthpct	90
					int	heightpct	90
					string	pattern	"upba3010.tga"
					string	text	"str_ldl_Radio_Group"
					stronglymodalradio {
						int	xpix	50
						int	ypix	30
						int	widthpix	150
						int	heightpix	30
						string	pattern	"upba3010.tga"
						string	text	"str_ldl_Strongly_Modal"
					}
					weaklymodalradio {
						int	xpix	50
						int	ypix	70
						int	widthpix	150
						int	heightpix	30
						string	pattern	"upba3010.tga"
						string	text	"str_ldl_Weakly_Modal"
					}
				}
			}
		}
	}
}


