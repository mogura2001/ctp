trigger 'TLevel4Cheat' when (g.player == g.tutorialplayer && player.cities > 1) {
	
	if(IsPlayerAlive(1)) {
		if(HasAdvance(g.tutorialplayer, ID_ADVANCE_SUBNEURAL_ADS)) {
			Message(1, 'KillAllMessages');
			Message(1, 'EnableTriggers3');
			Message(1, 'EnableTriggers4');
			DisableTrigger('TLevel4Cheat');

			Message(g.tutorialplayer, 'M3Goal3Accomplished');

			AddCityByIndex(g.tutorialplayer, 0);
			cheater = 1;
			EnableTileImprovementButton();
			EnableScreensButton();
	
			token = 25;
		}	
	}
}

//TypeLocation capital_location;
TypeLocation trade_city_1_location;
TypeLocation trade_city_2_location;
TypeCity trade_city_1;
TypeCity trade_city_2;

trigger 'TMakeCitiesForGoods' when (g.player == g.tutorialplayer && token == 25) {
	DisableTrigger('TMakeCitiesForGoods');
	Message(1, 'EnableTriggers4');
	
	DetachRobot(2);

	if(player.cities > 0) {
		AddCityByIndex(g.tutorialplayer, 0);
	}
	CreateCoastalCity(1, city.1.location, 7, trade_city_1); 
	ExtractLocation(trade_city_1, trade_city_1_location);

	CreateCoastalCity(1, trade_city_1_location, 4, trade_city_2);
	ExtractLocation(trade_city_2, trade_city_2_location);

	token = 26;			
}

TypeLocation city_1_good_location;
TypeLocation city_2_good_location;

trigger 'TAddGoodsToCities' when (g.player == g.tutorialplayer && token == 26) {
	DisableTrigger('TAddGoodsToCities');

	trade_city_1_beavers = GoodCount(trade_city_1, GoodType("TERRAIN_FOREST_GOOD_ONE")); 	
	if(!trade_city_1_beavers) {
		GetRandomNeighbor(trade_city_1_location, city_1_good_location);
		Terraform(city_1_good_location, 0);
		PlantGood(city_1_good_location);
	}

	if((GoodCount(trade_city_2, GoodType("TERRAIN_FOREST_GOOD_ONE"))) - trade_city_1_beavers <= 0) {
		GetRandomNeighbor(trade_city_2_location, city_2_good_location);
		Terraform(city_2_good_location, 0);
		PlantGood(city_2_good_location);
	}
	
	token = 27;
}


trigger 'TLevel4' when (g.player == g.tutorialplayer && level_4) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TLevel4');
	
	Message(g.tutorialplayer, 'MLevel4');

	level_4_saved = 1;
	SaveGame("level_4");
}


trigger 'TGood1Placed' when (g.player == g.tutorialplayer && (pop.location == city_1_good_location || 
(special.popmovedongood && city == trade_city_1 && good.type == GoodType("TERRAIN_FOREST_GOOD_ONE")))) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TGood1Placed');
	good_1_placed = 1;

	if(!good_2_placed) {
		Message(g.tutorialplayer, 'MMoveWorker2');
		token = 29;
	}

	if(good_2_placed) {
		if(IsPlayerAlive(1)) {
			CreateUnit(1, UnitType("UNIT_CARAVAN"), trade_city_1_location, 0);
		}
			Message(g.tutorialplayer, 'MCaravans');		
			DisableTrigger('TBothGoodsPlaced');
			DisableTrigger('TGood2Placed');
			token = 30;
	
	}
}

trigger 'TGood2Placed' when (g.player == g.tutorialplayer && (pop.location == city_2_good_location || 
(special.popmovedongood && city == trade_city_2 && good.type == GoodType("TERRAIN_FOREST_GOOD_ONE")))) {
	DisableTrigger('TGood2Placed');
	good_2_placed = 1;

	if(good_1_placed) {
		if(IsPlayerAlive(1)) {
			CreateUnit(1, UnitType("UNIT_CARAVAN"), trade_city_1_location, 0);
		}
		Message(1, 'KillAllMessages');
		Message(g.tutorialplayer, 'MCaravans');
		DisableTrigger('TBothGoodsPlaced');
		DisableTrigger('TGood1Placed');
		token = 30;
	}
}

trigger 'TBothGoodsPlaced' when (g.player == g.tutorialplayer && good_1_placed && good_2_placed) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TBothGoodsPlaced');

	if(IsPlayerAlive(1)) {
		CreateUnit(1, UnitType("UNIT_CARAVAN"), trade_city_1_location, 0);
	}

	Message(g.tutorialplayer, 'MCaravans');
	PlaySound("SOUND_ID_GENERALSUCCEED");
	token = 30;
}

trigger 'TTradeScreen' on "StatsWindow.TradeButton" when (g.player == g.tutorialplayer && token == 30) {
	Message(1, 'KillAllMessages');

	Message(g.tutorialplayer, 'ATheTradeScreen');
}

trigger 'TTradeSendButton' on "TradeMainWindow.SendButton" when (g.player == g.tutorialplayer && token == 30) {
	Message(1, 'KillAllMessages');

	Message(g.tutorialplayer, 'ASelectBeaver');
}

trigger 'TTradeNextButton' on "TradeSendWindow.NextButton" when (g.player == g.tutorialplayer && token == 30) {
	Message(1, 'KillAllMessages');
	
	Message(g.tutorialplayer, 'APickDestination');
}

trigger 'TTradeMakeTradeRoute' when (g.player == g.tutorialplayer && city.owner  == g.tutorialplayer && 
special.traderoute && token == 30) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TTradeNextButton');
	DisableTrigger('TTradeNextButton');
	DisableTrigger('TTradeSendButton');
	DisableTrigger('TTradeScreen');
	DisableTrigger('TTradeMakeTradeRoute');

	if(IsPlayerAlive(1)) {
		SetPlayer(1, g.tutorialplayer);
		AddCityByIndex(g.tutorialplayer, 0);
		if(player.totalunits < 1) {
			CreateUnit(1,UnitType("UNIT_WARRIOR"),CapitalCity_location, 1);
		}
	}

	Message(g.tutorialplayer, 'M4Goal1Accomplished');
	PlaySound("SOUND_ID_GENERALSUCCEED");
	token = 31;	
}	

trigger 'TCheat4' when (g.player == g.tutorialplayer && player.cities >= 2) {
	if(IsPlayerAlive(1)) {
		if(HasAdvance(g.tutorialplayer, ID_ADVANCE_INTELLIGENT_MATERIALS)) { 
			Message(1, 'KillAllMessages');
			Message(1, 'EnableTriggers3');
			Message(1, 'EnableTriggers4');
			DisableTrigger('TCheat4');
			AddCityByIndex(g.tutorialplayer, 0);
			AddPops(city.1, 5);
			Message(g.tutorialplayer, 'MLevel5');
			cheater = 1;
			EnableTileImprovementButton();
			EnableScreensButton();
			token = 31;
		}
	}
}

trigger 'TSaveLevel5' when (timer.1.expired) {
	DisableTrigger('TSaveLevel5');
	level_5_saved = 1;
	SaveGame("level_5");
	StopTimer(1);
}

trigger 'TMaxTab' on "ControlPanelWindow.CityUnitSelectedTabGroup.MacroTab" when (g.player == g.tutorialplayer && token == 31) {
	DisableTrigger('TMaxTab');
	
	max_tab = 1;	
}
		 
trigger 'TMaxScienceButton' on "ControlPanelWindow.CityUnitSelectedTabGroup.MacroTab.pane.MacroTabWallpaper.SwitchHolder.MacroSwitchGroup.MacroKnowledgeButton" 
when (g.player == g.tutorialplayer && token == 31) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TMaxScienceButton');
	AddPops(trade_city_1, 3);

	Message(g.tutorialplayer, 'M5Goal1Accomplished');
	PlaySound("SOUND_ID_GENERALSUCCEED");
	token = 32;
}

trigger 'TLaborTab' on "ControlPanelWindow.CityUnitSelectedTabGroup.MicroTab" when (g.player == g.tutorialplayer && token == 32) {
	DisableTrigger('TLaborTab');

	labor_tab = 1;
}

trigger 'TEntertainerMade' on "ControlPanelWindow.CityUnitSelectedTabGroup.MicroTab.pane.MicroTabWallpaper.MicroButtonHolder.MicroMusicianLabel.MicroMusicianPlus"
when (g.player == g.tutorialplayer && token == 32 && labor_tab) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TEntertainerMade');
	
	Message(g.tutorialplayer, 'MScientist');
}

trigger 'TScientistMade' on "ControlPanelWindow.CityUnitSelectedTabGroup.MicroTab.pane.MicroTabWallpaper.MicroButtonHolder.MicroScientistLabel.MicroScientistPlus"
when (g.player == g.tutorialplayer && token == 32 && labor_tab) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TScientistMade');

	Message(g.tutorialplayer, 'MSpecialistWarning');
	PlaySound("SOUND_ID_ALERT");
	token = 33;
}

trigger 'TQueueButton' on "ControlPanelWindow.CityUnitSelectedTabGroup.ProductionTab.pane.ProductionTabWallpaper.BuildButtonHolder.ProdQueueButton"
when (g.player == g.tutorialplayer) {
	if(token < 33) {
		Message(g.tutorialplayer, 'AAlertQueue');
	}

	if(token == 33) {
		Message(1, 'KillAllMessages');
		Message(g.tutorialplayer, 'MAddItemsToQueue');
	}

	if(token >= 33) {
		DisableTrigger('TQueueButton');
	}	
}

trigger 'TQueueMade' when (g.player == g.tutorialplayer && city.queue >= 2 && token == 33) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TQueueMade');

	Message(g.tutorialplayer, 'M5Goal2Accomplished');
	PlaySound("SOUND_ID_GENERALSUCCEED");
	token = 34;
}

trigger 'TCityStatus' on "StatsWindow.CityButton" when (g.player == g.tutorialplayer && token == 34) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TCityStatus');

	Message(g.tutorialplayer, 'AOrder2Cities');
}

trigger 'TCityBuildButtonUsed' on "CityStatusWin.BuildButton" when (g.player == g.tutorialplayer && token == 34) {
	DisableTrigger('TCityBuildButtonUsed');
	city_status_build_button = 1;
}

trigger 'TCitiesBuilding' on "CityStatusWin.OkButton" when (g.player == g.tutorialplayer && token == 34) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TCitiesBuilding');

	if(city_status_build_button) {
		Message(g.tutorialplayer, 'M5Goal3Accomplished');
		PlaySound("SOUND_ID_GENERALSUCCEED");
	}
	else {
		Message(g.tutorialplayer, 'MCitiesNotBuilding');
	}
	
	token = 35;
}

trigger 'TFortifiedUnits' when (g.player == g.tutorialplayer && token == 35 && unit.fortified) {		
	Message(1, 'KillAllMessages');
	DisableTrigger('TFortifiedUnits');
		
	Message(g.tutorialplayer, 'MFortifyInField');
	PlaySound("SOUND_ID_GENERALSUCCEED");

	token = 36;
}

TypeUnit FreeBoat;
TypeUnit FreeCargo;
TypeLocation WaterForBoat_location;

trigger 'TMakeFreeBoat' when (g.player == g.tutorialplayer && token == 36) {
	DisableTrigger('TMakeFreeBoat');
	AddCity(trade_city_1);
	ExtractLocation(trade_city_1, trade_city_1_location);

	If(IsPlayerAlive(1)) {
		SetPlayer(1, g.tutorialplayer);
		if(player.totalunits < 1) {
			CreateUnit(1,UnitType("UNIT_WARRIOR"),CapitalCity_location, 1);
		}
	
		CreateUnit(1, UnitType("UNIT_CHARIOT"), trade_city_1_location, 0, FreeCargo);
		GetNearestWater(trade_city_1_location, WaterForBoat_location);
		CreateUnit(1, UnitType("UNIT_TRIREMES"), WaterForBoat_location, 0, FreeBoat);
	}

	token = 37;

	level_6_saved = 1;
	SaveGame("level_6");
}
	
trigger 'TLoadedUnits' when (g.player == g.tutorialplayer && unit.embarked && token <= 37) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TLoadedUnits');

	Message(g.tutorialplayer, 'MMovingTheBoat');
	token = 38;
}

trigger 'TUnloadedUnits' when (g.player == g.tutorialplayer && unit.debarked && token >= 37) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TUnloadedUnits');

	Message(g.tutorialplayer, 'M6Goal1Accomplished');
	PlaySound("SOUND_ID_GENERALSUCCEED");
//	reenable_ingame = 1;
	token = 39;
}

