trigger 'TBeginTutorial' when(g.player == g.tutorialplayer) {
	Message(1, 'KillAllMessages');
	Message(1, 'DisableTriggers2');
	Message(1, 'DisableTriggers3');
	Message(1, 'DisableTriggers4');
//	SetTimerGranularity(1);

	if(player.cities == 0) {
		Message(g.tutorialplayer, 'MWelcomeCTP');
	}	
	if(token >= -2) {
		DisableTrigger('TBeginTutorial');
	}

	DisableTileImprovementButton();
	DisableScreensButton();
	DisableChooseResearch();
	GrantAdvance(g.tutorialplayer, 1);
	GrantAdvance(g.tutorialplayer, 0);
	GrantAdvance(g.tutorialplayer, 4);
	GrantAdvance(g.tutorialplayer, 15);

	choose_research_disabled = 1;
}

TypeLocation settler_moved_here_location;

trigger 'TMoveSettler' when (g.player == g.tutorialplayer && unit.moved && unit.type == UnitType("UNIT_SETTLER") && 
unit.owner == g.tutorialplayer && player.cities == 0) {
//MMoveSettler
	Message(1, 'KillAllMessages');
	DisableTrigger('TMoveSettler');

	ExtractLocation(unit, settler_moved_here_location);

	if(HasRiver(settler_moved_here_location)) {
		Message(g.tutorialplayer, 'MOnRiver');
	} else {
		Message(g.tutorialplayer, 'MCantMoveMore');
	}	
	PlaySound("SOUND_ID_GENERALSUCCEED");
	token = -4;
}


trigger 'TCycledTurn' when (g.player == g.tutorialplayer && g.year > 0 && player.cities == 0 && token == -4) {	
//MCantMoveMore
	Message(1, 'KillAllMessages');
	Message(g.tutorialplayer, 'MGoal1');
	DisableTrigger('TCycledTurn');
	token = -3;
}

trigger 'TCityNotBuilding' when (g.player == g.tutorialplayer && city.buildingnothing && player.cities == 1) {
	if(token != -1) {
	Message(1, 'KillAllMessages');
	Message(g.tutorialplayer, 'MGoal2');
	}
		if(player.cities > 1) {
			DisableTrigger('TCityNotBuilding');
		}
}

trigger 'TCityBuilt' when (g.player == g.tutorialplayer && city.built && player.cities == 1) {
//MHowToBuildCity
	DisableTrigger('TCityBuilt');
	Message(1, 'KillAllMessages');
	
//	if(city.owner == g.tutorialplayer) {
	Message(g.tutorialplayer, 'MGoal1Accomplished');
	PlaySound("SOUND_ID_GENERALSUCCEED");
//	}

	token = -2;
}

trigger 'TCityBuildingUnit' when (g.player == g.tutorialplayer && city.buildingunit == UnitType("UNIT_WARRIOR") && 
player.cities == 1) {
//MGoal2
	Message(1, 'KillAllMessages');
	DisableTrigger('TCityBuildingUnit'); 

	Message(g.tutorialplayer, 'MTurnsToComplete');
	PlaySound("SOUND_ID_GENERALSUCCEED");
	Attract("ControlPanelWindow.CityUnitSelectedTabGroup.ProductionTab.pane.ProductionTabWallpaper.InfoHolder.TurnText");
	city_is_building_unit = 1;
	build_defender_cue = 1;
	//start stall message counter
	stall_message = 1;

	DisableTrigger('TCityNotBuilding');

	token = -1;
}

trigger 'TStall1' when (g.player == g.tutorialplayer && keep_hitting_n == 1 && token < 1) {
//MBuildProgress
	Message(1, 'KillAllMessages');
	DisableTrigger('TStall1');

	choose_research_disabled = 0;
	EnableChooseResearch();
	
	Message(g.tutorialplayer, 'MStall1');
}

trigger 'TStall2' when (g.player == g.tutorialplayer && keep_hitting_n == 2 && token < 1) {
//MStall1
	Message(1, 'KillAllMessages');
	DisableTrigger('TStall2');

	Message(g.tutorialplayer, 'MStall4');
}

trigger 'TGoal2Accomplished' when(g.player == g.tutorialplayer && unit.built && city_is_building_unit && player.cities < 2) {
//trigger 'TGoal2Accomplished' when(g.player == g.tutorialplayer && unit.built == UnitType("UNIT_WARRIOR") && player.cities == 1) {
//MBuildProgress
	Message(1, 'KillAllMessages');
	DisableTrigger('TGoal2Accomplished');
	EnableChooseResearch();

	AddCityByIndex(g.tutorialplayer, 0);
	ClearBuildQueue(city);
	Message(g.tutorialplayer, 'MGoal2Accomplished');	
	PlaySound("SOUND_ID_GENERALSUCCEED");
	//reset stall counter
	stall_message = 0;	
	keep_hitting_n = 0;
	
	choose_research_disabled = 1;
	token = 1;
}

