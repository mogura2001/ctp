TypeUnit ChiefSittingDuck;
TypeLocation ChiefSittingDuck_location;
TypeLocation CapitalCity_location;

trigger 'TGimmeeAWarrior' when (g.player == g.tutorialplayer && token == 17) {
	Message(1, 'KillAllMessages');
	DisableTrigger('TGimmeeAWarrior');
	Message(1, 'EnableTriggers3');

	if(player.cities > 0) {
		Message(g.tutorialplayer, 'MLevel3');
		AddCityByIndex(g.tutorialplayer, 0);
		ExtractLocation(city.location, CapitalCity_location);
	}

	if(IsPlayerAlive(2)) {
		if(CreateUnit(2,UnitType("UNIT_WARRIOR"),CapitalCity_location, 2, ChiefSittingDuck)) {
			ExtractLocation(ChiefSittingDuck, ChiefSittingDuck_location);
		}
		
			if(TerrainType(ChiefSittingDuck_location) == 8 || TerrainType(ChiefSittingDuck_location) == 20 || 
			TerrainType(ChiefSittingDuck_location) == 22) {
			mountain_warrior = 1;	
			}	
	}									

	if(IsPlayerAlive(1)) {
		SetPlayer(1, g.tutorialplayer);
		if(!player.totalunits) {
			CreateUnit(1,UnitType("UNIT_WARRIOR"),CapitalCity_location, 2);
		}		
	}

	Message(g.tutorialplayer, 'MLevel2Save');

	level_3_saved = 1;
	SaveGame("level_3");
}

trigger 'TCheat' when (g.player == g.tutorialplayer && player.cities == 2) {
	
	if(IsPlayerAlive(1)) {
		if(HasAdvance(g.tutorialplayer, ID_ADVANCE_AI_SURVEILLANCE)) { 
			Message(1, 'KillAllMessages');
			Message(1, 'EnableTriggers2');
			DisableTrigger('TCheat');
			//creates warrior when 2 cities are built && gr 69 && start w/ level 3
			AddCityByIndex(g.tutorialplayer, 0);
			CreateUnit(1, UnitType("UNIT_KNIGHT"), city.location, 1); 
			Message(g.tutorialplayer, 'MLevel3');
			PlaySound("SOUND_ID_ELEPHANT");

			EnableTileImprovementButton();
			EnableScreensButton();
	
			token = 17;
		}	
	}
}

