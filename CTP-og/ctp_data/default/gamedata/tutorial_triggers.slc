//goes with TTurdBurglar
TypeUnit FreeWarrior;
TypeUnit FreeArcher;
TypeLocation FreeWarrior_location;
TypeLocation FreeArcher_location;

trigger 'TTurdBurglar' when (g.player == g.tutorialplayer && player.cities >= 1 && token == 19) {
	DisableTrigger('TTurdBurglar');
	Message(1, 'KillAllMessages');

	if(IsPlayerAlive(1)) {
		AddCityByIndex(g.tutorialplayer, 0);
		if(CreateUnit(1, UnitType("UNIT_WARRIOR"), city.1.location, 1, FreeWarrior)) {
				ExtractLocation(FreeWarrior, FreeWarrior_location);
		}
	
			if(CreateUnit(1, UnitType("UNIT_GREEK_FIRE"), FreeWarrior_location, 1, FreeArcher)) {
					ExtractLocation(FreeArcher, FreeArcher_location);
			}

				if(FreeWarrior_location == FreeArcher_location) {
					KillUnit(FreeWarrior);
 
 					if(CreateUnit(1,UnitType("UNIT_WARRIOR"), FreeArcher_location, 1, FreeWarrior)) {
						ExtractLocation(FreeWarrior, FreeWarrior_location);
					}
				}
	}
	Message(g.tutorialplayer, 'M3Goal2');
	PlaySound("SOUND_ID_ALERT");

	token = 20;
}

trigger 'TStackedUnits' when (g.player == g.tutorialplayer && unit.moved && UnitsInCell(unit.location) >= 2 && token == 20) {
//MKeepMoving
	DisableTrigger('TStackedUnits');
	Message(1, 'KillAllMessages');

	Message(g.tutorialplayer, 'MMixedForces');

	if(IsPlayerAlive(1)) {
		SetPlayer(1, g.tutorialplayer);
		if(player.totalunits < 2) {
			CreateUnit(1, UnitType("UNIT_WARRIOR"), CapitalCity_location, 2);
		}
	}

	token = 21;
}

