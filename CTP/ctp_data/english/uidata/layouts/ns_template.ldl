listitems {

	# for netshell special listboxes.

	nsitem:T_FONT1_16 {

		int	widthpix	60

		int	heightpix	20

	}



	# for the dropdown on the allinonewindow.

	playstyleitem {

		Name:T_FONT1_16 {

			int	widthpix	100

			int	heightpix	18

		}

	}



	# for the ages selection popup in the allinonewindow.

	ageitem {

		Name:T_FONT1_18 {

			int	widthpix	160

			int	heightpix	20

		}

	}



	# for the exclusions switches in the allinonewindow.

	exclusioncheckbox:T_FONT1_EXCLUDE {

		int	widthpix	215

		int	heightpix	20

		string	image0	"upba6320.tga"

		string	image1	"upba6321.tga"

	}



	# for the hybridplayerslistbox on the allinonewindow.

	# see that ldl block to make sure the dimensions below match columns.

	# don't compare the heights of the headers, just the widths.

	hplayeritem:T_FONT1_16 {

		# host

		int	widthpix	20

		int	heightpix	22



		launched:T_FONT1_16 {

			int	widthpix	20

			int	heightpix	22

		}



		name:T_FONT1_16 {

			int	widthpix	140

			int	heightpix	22

			string	just	"left"

			bool	vertcenter	true

		}



		ping:T_FONT1_16 {

			int	widthpix	45

			int	heightpix	22

		}



		tribe {

			int	widthpix	109

			int	heightpix	22

			button:T_FONT1_EXCLUDE2 {

				int	xpix	1

				int	ypix	3

				int	widthpix	107

				int	heightpix	16

				string pattern "upba6417.tga"

			}

		}


		civpoints {

			int	widthpix	91

			int	heightpix	22

			button:T_FONT1_12 {

				int	xpix	13

				int	ypix	3

				int	widthpix	65

				int	heightpix	16

				string	pattern	"upba6417.tga"

				int	min	100

				int	max	1000000

				int	val	100

				field {

					int	xpix	13

					int	ypix	3

					int	widthpix	65

					int	heightpix	16

					string	pattern	"upba6417.tga"

					bool	autohscroll	false

					bool	numeralonly	true

					int	min	100

					int	max	1000000

				}
			}

		}

		pwpoints {

			int	widthpix	91

			int	heightpix	22

			button:T_FONT1_12 {

				int	xpix	13

				int	ypix	3

				int	widthpix	65

				int	heightpix	16

				string	pattern	"upba6417.tga"

				int	min	1

				int	max	9

				int	val	1

				field {

					int	xpix	13

					int	ypix	3

					int	widthpix	65

					int	heightpix	16

					string	pattern	"upba6417.tga"

					bool	autohscroll	false

					bool	numeralonly	true

					int	min	1

					int	max	9

				}

			}

		}

	}

}



