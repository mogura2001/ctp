// diplomacy_pre_incoming.fli

#include "input_responses.fli"

////////////////////
/// WHO IS HE    ///
////////////////////

	////////////////////////////////////////////////////////////////
	////////// WHAT IS HIS RANKING?  ///////////
	////////////////////////////////////////////////////////////////

	input his_normalized_rank
		tri hes_in_last_place(his_normalized_rank, 0.0, 0.05)
		tri hes_in_bottom_half(his_normalized_rank, 0.3, 0.25)
		tri hes_in_middle_half(his_normalized_rank, 0.5, 0.25)
		tri hes_in_top_half(his_normalized_rank, 0.7, 0.25)
		tri hes_in_first_place(his_normalized_rank, 1.0, 0.05)

	////////////////////////////////////////////////////////
	////////// IS HE MY BEST FRIEND?  //////////////////////
	////////////////////////////////////////////////////////

	input best_friend
		tri not_best_friend(best_friend, 0.01, 0.5)
		tri my_best_friend(best_friend, 1.0, 0.5)

	////////////////////////////////////////////////////////
	////////// IS HE MY WORST ENEMY?  //////////////////////
	////////////////////////////////////////////////////////

	input worst_enemy
		tri not_worst_enemy(worst_enemy, 0.01, 0.5)
		tri my_worst_enemy(worst_enemy, 1.0, 0.5)

	/////////////////////////////////////////////////////////////////////////////
	////////// HOW LONG HAVE I BEEN AT PEACE CONTINUOUSLY?  /////////////////////
	/////////////////////////////////////////////////////////////////////////////
	// AM I READY FOR MORE WAR?

	input shortest_peace
		tri zero_length_peace(shortest_peace, 0.0, 0.5)
		tri a0to5_peace(shortest_peace, 5.0, 5.0)
		tri a5to15_peace(shortest_peace, 10.0, 5.0)
		tri a10to20_peace(shortest_peace, 15.0, 5.0)
		right a20plus_peace(shortest_peace, 20.0, 5.0)

	output tired[0.0, 2.0] =0.0
		tri yes_tired(tired, 1.0, 0.5)

	output barely_refreshed[0.0, 2.0] =0.0
		tri yes_barely_refreshed(barely_refreshed, 1.0, 0.5)

	output refreshed[0.0, 2.0] =0.0
		tri yes_refreshed(refreshed, 1.0, 0.5)

	if(zero_length_peace or a0to5_peace or a5to15_peace)
		{
			yes_tired
		}

	if(a20plus_peace)
		{
			yes_refreshed
		}
	
	if(a10to20_peace and not yes_refreshed and not yes_tired)
		{
			yes_barely_refreshed
		}

	/////////////////////////////////////////////////////////////////////////////
	////////// HOW LONG HAVE I BEEN FIGHTING CONTINUOUSLY?  /////////////////////
	/////////////////////////////////////////////////////////////////////////////

	input longest_war
		tri a0_longest_war(longest_war, 0.0, 0.5)
		tri a1to10_longest_war(longest_war, 5.0, 5.0)
		tri a5to15_longest_war(longest_war, 10.0, 5.0)
		tri a10to20_longest_war(longest_war, 15.0, 5.0)
		tri a20to30_longest_war(longest_war, 25.0, 5.0)
		tri a25to35_longest_war(longest_war, 30.0, 5.0)
		tri a30to50_longest_war(longest_war, 40.0, 10.0)
		right a50plus_longest_war(longest_war, 55.0, 5.0)

	output nearly_tired_of_war[0.0,2.0] = 0.0
		tri yes_nearly_tired_of_war(nearly_tired_of_war, 1.0, 0.5)

	output tired_of_war[0.0,2.0] = 0.0
		tri yes_bored_of_war(tired_of_war, 1.0, 0.5)

	output sick_of_war[0.0,2.0] = 0.0
		tri yes_sick_of_war(sick_of_war, 1.0, 0.5)


	// GET TIRED OF WAR AFTER A LONG TIME
	if(a20to30_longest_war)
		{
			yes_nearly_tired_of_war
		}

	// GET TIRED OF WAR AFTER A LONG TIME
	if(a30to50_longest_war)
		{
			yes_bored_of_war
		}

	// GET SICK AND TIRED OF WAR AFTER A VERY LONG TIME
	if(a50plus_longest_war)
		{
			yes_sick_of_war
		}

	////////////////////////////////////////////////////////
	////////// DO WE HAVE A CEASE FIRE /////////////////////
	////////////////////////////////////////////////////////

	input cease_fire_with_him
		left no_cease_fire(cease_fire_with_him, 0.0, .5)
		right yes_cease_fire(cease_fire_with_him, 1.0, .5)

	///////////////////////////////////////////////////////
	////////// DO WE HAVE AN ALLIANCE /////////////////////
	///////////////////////////////////////////////////////

	input alliance_with_him
		left no_alliance(alliance_with_him, 0.0, .5)
		right yes_alliance(alliance_with_him, 1.0, .5)

	////////////////////////////////////////////////////////////////
	////////// ARE WE NEUTRAL? /////////////////////
	////////////////////////////////////////////////////////////////

	input neutral_with_him
		left no_neutral(neutral_with_him, 0.0, .5)
		right yes_neutral(neutral_with_him, 1.0, .5)

	///////////////////////////////////////////////////////////////
	////////// ARE WE AT WAR?  /////////////////////
	///////////////////////////////////////////////////////////////

	input war_with_him
		left no_war (war_with_him, 0.0, .5)
		right yes_war (war_with_him, 1.0, .5)

	///////////////////////////////////////////////////////////////////////////////////
	////////// HOW DO I FEEL ABOUT HIM?  /////////////////////
	///////////////////////////////////////////////////////////////////////////////////

	input diplomatic_regard_towards_him
		left hate_him(diplomatic_regard_towards_him, 10, 12)
		tri dislike_him(diplomatic_regard_towards_him, 30, 12)
		tri neutral_towards_him(diplomatic_regard_towards_him, 50, 12)
		tri like_him(diplomatic_regard_towards_him, 70, 12)
		right love_him(diplomatic_regard_towards_him, 90, 12)

	//////////////////////////////////////////////////////////////////////////////////////
	////////// HOW LONG HAVE WE FOUGHT?  //////////////////////
	//////////////////////////////////////////////////////////////////////////////////////

	input length_of_war_with_him
		tri zero_length_war_with_him(length_of_war_with_him, 0.0, 0.5)
		tri a1to9_turn_war_with_him(length_of_war_with_him, 5.0, 4.5)
		tri a6to14_turn_war_with_him(length_of_war_with_him, 10.0, 5.0)
		tri a11to19_turn_war_with_him(length_of_war_with_him, 15.0, 5.0)
		right a16to14_length_war_with_him(length_of_war_with_him, 20.0, 5.0)

	////////////////////////////////////////////////////////////////
	////////// CAN HE BE TRUSTED?  ///////////
	////////////////////////////////////////////////////////////////

	// this sets how loyal I think that he is
	input loyalty
		tri distrust_him(loyalty, 10.0, 10.0)
		tri dont_trust_him(loyalty, 20.0, 10.0)
		tri watch_him(loyalty, 30.0, 10.0)
		tri maybe_trust_him(loyalty, 40.0, 10.0)
		tri completely_trust_him(loyalty, 50.0, 10.0)


	output i_do_not_trust_him[0.0, 2.0] = 0.0
		tri yes_i_do_not_trust_him(i_do_not_trust_him, 1.0, 0.5)

		if( distrust_him
			or dont_trust_him )
		{
			yes_i_do_not_trust_him
		}

	//////////////////////////////////////////////////////////////////////////////////////
	////////// IS HE STRONGER OR WEAKER?  /////////////////////
	//////////////////////////////////////////////////////////////////////////////////////

	input relative_strength
		left terrified_of_him(relative_strength, 0.1, 0.3) 
		tri afraid_of_him(relative_strength, 0.5, 0.25)
		tri equal_to_him(relative_strength, 1, 0.2)
		right stronger_than_him(relative_strength, 2.5, 0.25)

	output he_is_scary[0.0, 2.0] =0.0
		tri yes_he_is_scary(he_is_scary, 1.0, 0.5)

	if(terrified_of_him or afraid_of_him)
	{
		yes_he_is_scary
	}

	/////////////////////////////////////////////////////
	////////// IS HE HUMAN?  ///////////
	/////////////////////////////////////////////////////

	input player_type
		tri human(player_type, 0.0, 0.1)
		tri ai(player_type, 1.0, 0.1)
		tri humanclient(player_type, 2.0, 0.1)

	//////////////////////////////////////////////////////////////////////////////////////
	////////// HOW MUCH HAS HE ATTACKED ME?  //////////////////////
	//////////////////////////////////////////////////////////////////////////////////////

	input his_hotwar_attacked_me // How many times he's ever attacked
		left hasnt_attacked_me(his_hotwar_attacked_me, 0, 0.2)
		tri once_attacked_me(his_hotwar_attacked_me, 1, 0.5)
		right often_attacked_me(his_hotwar_attacked_me, 2, 0.5)

	output his_hotwar_attacked_me_decay [0, 1.0] = 0.6

////////////////////////
/// WHO AM I? //////////
////////////////////////


	////////////////////////////////////////////////////////////////
	////////// WHAT IS MY RANKING?  ///////////
	////////////////////////////////////////////////////////////////

	input my_normalized_rank
		tri iam_in_last_place(his_normalized_rank, 0.0, 0.05)
		tri iam_in_bottom_half(his_normalized_rank, 0.3, 0.25)
		tri iam_in_middle_half(his_normalized_rank, 0.5, 0.25)
		tri iam_in_top_half(his_normalized_rank, 0.7, 0.25)
		tri iam_in_first_place(his_normalized_rank, 1.0, 0.05)

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	////////// HOW LONG HAVE I BEEN FIGHTING CONTINUOUSLY?  /////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	input longest_war
		tri zero_length_war(longest_war, 0.0, 0.5)
		tri five_length_war(longest_war, 5.0, 5.0)
		tri ten_length_war(longest_war, 10.0, 5.0)
		tri fifteen_length_war(longest_war, 15.0, 5.0)
		right twenty_length_war(longest_war, 20.0, 5.0)

	////////////////////////////////////////////////////////////////////////////////////////////////////
	////////// HOW MANY PLAYERS AM I FIGHTING?  /////////////////////
	////////////////////////////////////////////////////////////////////////////////////////////////////

	input at_war_count
		tri zero_at_war(at_war_count, 0.0, 0.5)
		tri one_at_war(at_war_count, 1.0, 0.5)
		tri two_at_war(at_war_count, 2.0, 0.5)
		tri three_at_war(at_war_count, 3.0, 0.5)
		tri four_at_war(at_war_count, 4.0, 0.5)
		tri five_at_war(at_war_count, 5.0, 0.5)
		tri six_at_war(at_war_count, 6.0, 0.5)
		tri seven_at_war(at_war_count, 7.0, 0.5)
		tri eightplus_at_war(at_war_count, 8.0, 0.5)

	output too_many_enemies[0.0, 2.0] = 0.0
		tri yes_too_many_enemies(too_many_enemies, 1.0, 0.5)

	if( three_at_war 
		or four_at_war 
		or five_at_war 
		or six_at_war
		or seven_at_war
		or eightplus_at_war )
	{
		yes_too_many_enemies
	}

	if(	peaceful 
		and two_at_war)
	{
		yes_too_many_enemies
	}

/////////////////////////////////////////////////
//////////   SET ACCEPTANCE   ///////////
////////////////////////////////////////////////

	output accept_threshold[-500, 1500] = 1000
		tri best_reason_to_accept (accept_threshold, 0, 200);
		tri good_reason_to_accept(accept_threshold, 250, 100);
		tri average_reason_to_accept(accept_threshold, 500, 100);
		tri bad_reason_to_accept(accept_threshold, 750, 100);
		tri worst_reason_to_accept(accept_threshold, 1000, 200);
		tri zero_reason_to_accept(accept_threshold, 1000, 500)

	output found_accept[0.0, 1.2] = 0.0
		tri unfound(found_accept, 0.15, 0.1)
		tri found(found_accept, 1.0, 0.1)

/////////////////////////////////////////////////
//////////   SET REGARD   ///////////
////////////////////////////////////////////////

output diplomatic_regard_delta[-50, 50] = 0.0
	tri loath_him_more(diplomatic_regard_delta, -10, 10.0)
	tri hate_him_more(diplomatic_regard_delta, -8, 4.0)
	tri dislike_him_more(diplomatic_regard_delta, -5, 2.0)
	tri wary_of_him_more(diplomatic_regard_delta, -3, 1.0)
	tri same_like_him(diplomatic_regard_delta, 0, 8.0)
	tri like_him_more(diplomatic_regard_delta, 2, 1.0)
	tri love_him_more(diplomatic_regard_delta, 5, 2.0)
	right worship_him_more(diplomatic_regard_delta, 8, 4)
	
input military_incursions
	left no_incursions(military_incursions, 0, 0.2)
	tri few_incursions(military_incursions, 2, 1.8)
	right many_incursions(military_incursions, 3, 1)

/////////////////////////////////////
////////// DEAL WITH ATTACKS  ///////
/////////////////////////////////////

	if(once_attacked_me or often_attacked_me) 
		{
			very bad_reason_to_accept
		}

/////////////////////////////////////
////////// SEND GREETING  ///////////
/////////////////////////////////////

input contact_gained
	right gives_contact_gained(contact_gained, 1.0, 0.5)

		if(gives_contact_gained and not hate_him) 
		{
			good_reason_to_accept
			like_him_more
		}

///////////////////////////////////////////
////////// RESPOND TO DEMANDS   ///////////
///////////////////////////////////////////

	/////////////////////////////////////////////////
	////////// RESPOND TO DEMAND ADVANCE  ///////////
	/////////////////////////////////////////////////
	/// 	// ww 11/19 monitoring
	///	double cost;
	///	extern double fz_time;
	///
	///	// cost of the advance that I have to give up
	///	cost = ai->m_science->GetCost(request->GetAdvance());
	///
	///	// I want to adjust the cost to reflect the rising costs of advances through the game
	///	// Hopefully, this lets the AI know whether an Advance is worth more or worth less
	///	// than the average Advance of the time.
	///	double adjcost = cost * 2 / (fz_time + 25);
	///	
	///	// This keeps the multiplier within a reasonable bound
	///	if (adjcost > 5)
	///	{
	///		adjcost = 5;
	///	}
	///
	///	// if it is worthless, I'll give it up; otherwise, no way; 
	///	return adjcost * k_POOR_VALUE * fz_give_advance;
	
	input i_gain_advance
		right yes_i_gain_advance(i_gain_advance, 1.0, .5)

	input he_gains_advance
		right yes_he_gains_advance(he_gains_advance, 1.0, 0.5)

	// can use advance_cost if we want

		if(yes_he_gains_advance and not yes_i_gain_advance)
		{
			found
		}

	output give_advance [0, 2] = 1.0
		left no_way_give_adv(give_advance, 0, 0.5)
		tri maybe_give_adv(give_advance, 0.5, 0.25)
		right yes_give_adv(give_advance, 1.0, 0.5) 

		if(	yes_he_gains_advance and not yes_i_gain_advance 
			and terrified_of_him
			and not yes_enough_me_giving_in_to_DEMAND_ADVANCE) 
			{
				average_reason_to_accept
				maybe_give_adv
			} 

		if(	yes_he_gains_advance and not yes_i_gain_advance 
			and my_best_friend
			and not yes_enough_me_giving_in_to_DEMAND_ADVANCE)
			{
				average_reason_to_accept
				wary_of_him_more
			}

		if(	yes_he_gains_advance and not yes_i_gain_advance	
			and yes_enough_me_giving_in_to_DEMAND_ADVANCE 
			and not love_him )
			{
				zero_reason_to_accept
				no_way_give_adv
				dislike_him_more
			}

		/// Now set the regard based on our responses.	
		if(	yes_he_gains_advance and not yes_i_gain_advance 
			and average_reason_to_accept)
			{	
				dislike_him_more
			}

		if(	yes_he_gains_advance and not yes_i_gain_advance  
			and bad_reason_to_accept)
			{	
				hate_him_more
			}

	//////////////////////////////////////////////
	////////// RESPOND TO DEMAND CITY  ///////////
	//////////////////////////////////////////////
	// THIS IS CUT -- BUT WE'LL TURN IT OFF ANYWAY
	// return 0.0

	input i_lose_city
		tri yes_i_lose_city(i_lose_city, 1.0, 0.5)

	input he_gains_city
		tri yes_he_gains_city(he_gains_city, 1.0, 0.5)

	if(yes_i_lose_city and yes_he_gains_city)
	{
		worst_reason_to_accept
		found
	}

	////////////////////////////////////////////
	////////// RESPOND TO DEMAND MAP  //////////
	////////////////////////////////////////////
	///		MapPointData *size = ai->m_map->GetSize();
	///		
	///		double explored = ai->m_map->ExploredArea(ai);
	///		return k_POOR_VALUE - k_AVERAGE_VALUE * (explored / (size->x * size->y));

	input i_gain_map
		tri yes_i_gain_map(i_gain_map, 1.0, 0.5)

	input he_gets_map
		tri yes_he_gets_map(he_gets_map, 1, .5)

	// don't use input last_got_map; it means nothing
	// N: preceding: normalized

	if(	yes_he_gets_map and not yes_i_gain_map)
		{
			found
		}

	if(	yes_he_gets_map and not yes_i_gain_map 
		and terrified_of_him 
		and not my_worst_enemy) 
		{
			good_reason_to_accept
		}
	
	if(	yes_he_gets_map and not yes_i_gain_map 
		and my_best_friend 
		and love_him) 
		{
			best_reason_to_accept
		}
	
	// N: added...If we're allied, have a map
	if(	yes_he_gets_map and not yes_i_gain_map 
		and yes_alliance 
		and not hate_him ) 
		{
			best_reason_to_accept
		}

	// N: added...If we have a treaty, have a map
	if(	yes_he_gets_map and not yes_i_gain_map 
		and yes_cease_fire 
		and not hate_him
		and not yes_war) 
		{
			best_reason_to_accept
		}


	if(	yes_he_gets_map and not yes_i_gain_map	
		and yes_enough_me_giving_in_to_DEMAND_MAP 
		and not love_him )
		{
			zero_reason_to_accept
			no_way_give_adv
			dislike_him_more
		}
	// N: added..If I'm tough & don't like you, watch it!
	if(	yes_he_gets_map and not yes_i_gain_map	
		and yes_enough_me_giving_in_to_DEMAND_MAP 
		and not (like_him or love_him ))
		{
			zero_reason_to_accept
			no_way_give_adv
			hate_him_more
		}


		// N: all changed...Now set regard based on our responses.
		if(	yes_he_gets_map and not yes_i_gain_map 
			and best_reason_to_accept)
			{	
				same_like_him
			}

		if(	yes_he_gets_map and not yes_i_gain_map  
			and good_reason_to_accept)
			{	
				same_like_him
			}

		if(	yes_he_gets_map and not yes_i_gain_map  
			and average_reason_to_accept)
			{	
				same_like_him
			}

		if(	yes_he_gets_map and not yes_i_gain_map  
			and bad_reason_to_accept)
			{	
				dislike_him_more
			}

		if(	yes_he_gets_map and not yes_i_gain_map  
			and worst_reason_to_accept)
			{	
				hate_him_more
			}

	//////////////////////////////////////////////
	////////// RESPOND TO DEMAND GOLD  ///////////
	//////////////////////////////////////////////
	///		double gold = request->GetGold();
	///			double savings = ai->m_gold->GetCurrentSavings();
	///			if(gold > savings )
	///				return 0.0;
	///				
	///			double goldpart = gold / savings;
	///				
	///			return k_AVERAGE_VALUE * goldpart;
	///
	/// ask for more than 50% of my gold and I need a definitely or better

	input he_gains_gold
		tri yes_gives_him_gold(he_gains_gold, 1, 0.5)

	if(yes_gives_him_gold)
	{
		found
	}
		
	if(	yes_gives_him_gold and terrified_of_him and not distrust_him) 
		{
			best_reason_to_accept
		}
	
	if(	yes_gives_him_gold and my_best_friend and peaceful)
		{
			best_reason_to_accept
		}

	if(	yes_gives_him_gold	
		and yes_enough_me_giving_in_to_DEMAND_GOLD
		and not love_him )
		{
			zero_reason_to_accept
			no_way_give_adv
		}

		// Now set regard based on responses.
		if(	yes_gives_him_gold   
			and zero_reason_to_accept)
			{	
				hate_him_more
			}

		if(	yes_gives_him_gold   
			and best_reason_to_accept)
			{	
				dislike_him_more
			}

	///////////////////////////////////////////////////////////////////////
	////////// RESPOND TO DEMAND STOP TRADING WITH ANOTHER CIV  ///////////
	///////////////////////////////////////////////////////////////////////
	///		double tradewiththird = ai->m_player->GetTradeWith(sint32(request->GetThirdParty()));
	///			
	///			// friendship is calculated in the fz system
	///			return k_GOOD_VALUE - (tradewiththird * fz_trade_utility);

	// check for stop trade message
	input stops_trade_with_third_party
		tri yes_stops_trade_with_third_party(stops_trade_with_third_party, 1, .5)

	// legal: third_party_strength
	// legal: third_party_relative_strength
	// legal: his_third_party_relative_strength
	
	if(yes_stops_trade_with_third_party)
	{
		found
	}

	// his trade with third party
	// if 100, 10 Routes = dont do it
	// if 500, 2 Routes = don't do it
	// if zero routes -- I always say yes
	input his_trade_with_third_party
		left no_trade_with_third(his_trade_with_third_party, 0, 0.1)
		tri some_trade_with_third_party(his_trade_with_third_party, 2, 1)
		right much_trade_with_third_party(his_trade_with_third_party, 5, 2)

	// my opinion of the third party
	input third_party_regard
		tri hate_third_party(third_party_regard, 10, 10)
		tri dislike_third_party(third_party_regard, 30, 10)
		tri neutral_toward_third_party(third_party_regard, 50, 10)
		tri like_third_party(third_party_regard, 70, 10)
		tri love_third_party(third_party_regard, 90, 10)

	output trade_utility [0, 1000] = 1000
		left ok_i_stop (trade_utility, 0, 100)
		tri maybe_i_stop (trade_utility, 500, 250)
		right no_way_jose (trade_utility, 1000, 250)

	// if I love him or he's my best friend and I don't like the other guy anyway, I'll say yes
	if( 	yes_stops_trade_with_third_party
		and love_him 
		and my_best_friend 
		and hate_third_party)
		{
			ok_i_stop
		}
	// if I like him or am neutral and I'm not trading with the other guy anyway, I'll maybe say yes
	if(	yes_stops_trade_with_third_party 
		and (like_him or neutral_towards_him or love_him)
		and hate_third_party 
		and no_trade_with_third )
		{
			ok_i_stop	
		}
		
	if(	yes_stops_trade_with_third_party 
		and (dislike_him or hate_him)
		and my_worst_enemy)
		{
			no_way_jose
		}

	if(	yes_stops_trade_with_third_party 
		and hate_third_party 
		and not distrust_him)
		{
			average_reason_to_accept
			dislike_him_more
		}

	if(	yes_stops_trade_with_third_party 
		and distrust_him)
		{		
			worst_reason_to_accept
		}
			
	////////////////////////////////////////////////////////////
	////////// RESPOND TO DEMAND ATTACK ANOTHER CIV  ///////////
	////////////////////////////////////////////////////////////
	///		if (regardthird > 60)
	///		{
	///			return 0.0;
	///		}
	///		// otherwise attack people that I don't like in most cases
	///		return k_BEST_VALUE - (foreigner->GetRegard() * 10);

	///		utility = 400 with Regard = 60; 
	///		utility = 1000 with Regard = 0;

	input i_will_attack_third_party
