	if(yes_i_will_attack_third_party)
	{
		found
	}
	
	// if I'm at war with the third party, I don't mind attacking them
	if(	yes_i_will_attack_third_party
		and yes_at_war_with_third_party)
		{
			best_reason_to_accept
		}

	if(	yes_i_will_attack_third_party
		and (dislike_third_party or hate_third_party)
		and my_best_friend 
		and zero_at_war)
	{
		best_reason_to_accept
	}

	if(	yes_i_will_attack_third_party 
		and (dislike_third_party or hate_third_party)
		and my_best_friend 
		and i_am_stronger_than_3rd)
	{
