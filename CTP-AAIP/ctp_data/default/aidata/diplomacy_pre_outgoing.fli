////////////////////////////

	////////////////////////////////////
	/// SHOULD I EXCHANGE ADVANCES   ///
	////////////////////////////////////
	// 	// ratio of his cost to mine * ratio of his skipped advances to mine 
	//	if(hiscost > mycost)
	//	{
