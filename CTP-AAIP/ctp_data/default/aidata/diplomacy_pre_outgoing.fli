	//	}		

	// weird stuff in weightoptions
	// see demands for inputs

	// exchange advance send 
	if(advance_to_me and advance_to_him)
	{
		medlow_priority
	}
	// N: changed

		if(advance_to_me and advance_to_him 
			and ai 
			and not yes_war 
			and (not hate_him or not dislike_him) 
			and not hes_in_first_place 
			and not iam_in_first_place)
		{
			best_message_to_send
			found
		}

	
		if(	advance_to_me 
			and advance_to_him 
			and yes_war)
		{
			worst_message_to_send
			rand_min_25
			rand_max_100
			found
		}

		// you feel like you're someones best friend
		if(	advance_to_me 
			and advance_to_him 
			and my_best_friend
			and (love_him or like_him) 
			and not yes_war)
		{
			best_message_to_send
			rand_min_25
			rand_max_100
			found
		}

		// N...Changed...you feel like someone is peaceful
		if(	advance_to_me 
			and advance_to_him 
			and peaceful 
			and not my_worst_enemy
			and not yes_war )
		{ 
			best_message_to_send
			rand_min_25
			rand_max_100
			found
		}

		// N: added...feel like warlike is peaceful
		if(	advance_to_me 
			and advance_to_him 
			and warlike
			and (love_him or like_him) 
			and not yes_war)
		{
			good_message_to_send
			rand_min_25
			rand_max_100
			found
		}


	/////////////////////////////////
	/// SHOULD I  EXCHANGE MAPS   ///
	/////////////////////////////////
	// 	if(regard_to_him < 70) return 0;
	//	if(percent_explored < .3) return k_GOOD_VALUE; 
	//	if(percent_explored > .8) return k_POOR_VALUE;
	//	return k_AVERAGE_VALUE;
	//}
	// set fz_map_exchange -- this hideous variable sets a variable inside the utility command
	// In a way, the AI is adjusting the utility with this -- something it is supposed to leave
	// alone. 
	

	// inputs under demand...N: priority changed
	if(	yes_i_gain_map 
		and yes_he_gets_map
		and not yes_he_has_been_asked_to_EXCHANGE_MAP)
	{
		med_priority
	}

	if(	yes_i_gain_map 
		and yes_he_gets_map 
		and (dislike_him or hate_him))
	{
		worst_message_to_send
		rand_min_25
		rand_max_100
		found
	}

	if(	yes_i_gain_map 
		and yes_he_gets_map 
		and yes_war)
	{
		worst_message_to_send
		rand_min_25
		rand_max_100
		found
	}

	// N: changed
	if(	yes_i_gain_map and yes_he_gets_map 
		and love_him 
		and my_best_friend 
		and not yes_war
		and not yes_he_has_been_asked_to_EXCHANGE_MAP
		and not yes_youve_got_my_map)
	{
		best_message_to_send
		rand_min_25
		rand_max_100
		found
	}
	// N: added...If we're allies, let's trade maps
	if(	yes_i_gain_map and yes_he_gets_map 
		and yes_alliance 
		and not yes_war
		and not yes_he_has_been_asked_to_EXCHANGE_MAP
		and not yes_youve_got_my_map)
	{
		best_message_to_send
		rand_min_25
		rand_max_100
		found
	}
	// N: added...If we have a treaty, let's trade maps
	if(	yes_i_gain_map and yes_he_gets_map 
		and yes_cease_fire
		and not yes_war
		and not yes_he_has_been_asked_to_EXCHANGE_MAP
		and not yes_youve_got_my_map)
	{
		best_message_to_send
		rand_min_25
		rand_max_100
		found
	}

//	// N: added...if we're at war & peaceful, I may
