////////////////////////
/// SHOULD I ALLY   ////
////////////////////////
	/////////////////////////////////
	/// SHOULD I OFFER ALLIANCE   ///
	/////////////////////////////////
	///		if(foreigner->GetRegard() > 50 && fz_loyalty > 30)
	///		{
	///		return (ai->GetStrength(foreigner->GetPlayerIndex()) / mystrength) * 250 * fz_alliance;	
	/// 	}
	///		otherwise I don't ever want to do this
	///		return 0.0;
	
	input gains_alliance
		right does_gain_alliance(gains_alliance, 1, .5)

	if(does_gain_alliance)
	{
		high_priority
	}

	input num_he_is_at_war
		left a0_he_is_at_war(num_he_is_at_war, 0, 0.2)
		tri a1to3_he_is_at_war(num_he_is_at_war, 2, 1)
		tri a2to6_he_is_at_war(num_he_is_at_war, 4, 2)
		right a5to11_he_is_at_war(num_he_is_at_war, 8, 3)

	output alliance [0,1] = 0
		right no_alliance(alliance, 0, 0.2)
		tri perchance_alliance(alliance, 0.5, 0.25)
		left married(alliance, 1.0, 0.25)

		if(	does_gain_alliance 
			and my_best_friend 
			and not yes_war 
			and (not distrust_him or not dont_trust_him))
		{
			good_message_to_send
			found
		}
	
		if(does_gain_alliance 
			and (like_him or love_him) 
			and a1to3_he_is_at_war 
			and not yes_war 
			and (not distrust_him or not dont_trust_him))
		{
			good_message_to_send
			found
		}

	
		if(does_gain_alliance 
			and love_him 
			and not zero_at_war 
			and not yes_war 
			and (not distrust_him or not dont_trust_him) )
		{
			best_message_to_send
			found
		}

		// N: added...
		if(does_gain_alliance
			and ai
			and warlike 
			and like_him 
			and not zero_at_war 
			and not yes_war 
			and (not distrust_him or not dont_trust_him) )
		{
			best_message_to_send
			found
		}

		// N: added...
		if(does_gain_alliance
			and ai
			and neutral_towards_him 
			and like_him 
			and not zero_at_war 
			and not yes_war 
			and (not distrust_him or not dont_trust_him) )
		{
			best_message_to_send
			found
		}

		// N: added: don't ask for alliance if allied
		if(	does_gain_alliance 
			and yes_alliance  
			and not yes_war )
		{
			worst_message_to_send
			found
		}

	///////////////////////////////////
	/// SHOULD I OFFER AN ECOPACT   ///
	///////////////////////////////////
	//	if(fz_pact_end_pollution > 500)  
	//	{
	//		return (global_pollution / pollutiontrigger) * 	fz_pact_end_pollution;
	//	}
	//	return 0;


	input end_pollution_pact
		tri yes_end_pollution_pact(end_pollution_pact, 1.0, 0.1)

	if(yes_end_pollution_pact)
	{
		med_priority
	}

	output pact_end_pollution [0, 1000]= 0
		left toxic_wastrel(pact_end_pollution, 0, 100)
		tri joe_lunchpail(pact_end_pollution, 500, 250)
		right pollution_sucks(pact_end_pollution, 1000, 250)

		if(	yes_end_pollution_pact 
			and (high_his_pollution or high_my_pollution) 
			and (not distrust_him or not dont_trust_him))
		{
			worst_message_to_send
			pollution_sucks
			rand_min_25
			rand_max_100
			found
		}
	
		if(	yes_end_pollution_pact 
			and (average_his_pollution or average_my_pollution) 
			and (not distrust_him or not dont_trust_him))
		{
			worst_message_to_send
			joe_lunchpail
			rand_min_25
			rand_max_100
			found
		}
	
		if(	yes_end_pollution_pact 
			and (low_his_pollution or low_my_pollution) 
			and (not distrust_him or not dont_trust_him))	
		{
			toxic_wastrel
			rand_min_25
			rand_max_100
			found
		}

		if(	yes_end_pollution_pact 
			and high_global_pollution 
			and (not distrust_him or not dont_trust_him))
		{
			good_message_to_send
			rand_min_25
			rand_max_100
			found
		}

		// N: added
		if(	yes_end_pollution_pact 
			and high_global_pollution 
			and peaceful
			and not yes_war)
		{
			good_message_to_send
			rand_min_25
			rand_max_100
			found
		}

		// N: added
		if(	yes_end_pollution_pact 
			and high_global_pollution 
			and iam_in_first_place
			and not yes_war)
		{
			good_message_to_send
			rand_min_25
			rand_max_100
			found
		}


///////////////////////
/// NOTHING FOUND   ///
///////////////////////
// this ensures that we say no if nothing fires

		if(not found) 
		{
			worst_message_to_send
			low_priority
		}
 
		// N: added
		if(not found
			and not (distrust_him or dont_trust_him)
			and not hate_him ) 
		{
			okay_message_to_send
			med_priority
		}
 


