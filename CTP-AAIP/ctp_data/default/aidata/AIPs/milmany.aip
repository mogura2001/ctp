/////////////////////////////////////////////////////////////////////////////// // milmany.aip
// // 
// // milmany.aip
// // 
// Specifies the behavior of the Strategic Combat system for Civ  
///////////////////////////////////////////////////////////////////////////////  
#include "aipdef.h"   
    
    
// PRIORITIES  
//  
// Although these priorities should be principally set by the fuzzy system,  
// for testing purposes, I've put the ability specify any or all of them to  
// be changed in a big fat wad when the AIP switches.  
    
double seige_priority = 405000.0; 
double attack_troops_priority = 405000.0; 
double bombard_priority = 407000.0; 
double perimeter_priority = 5000.0; 
double patrol_priority = 5000.0; 
double harass_priority = 7000.0; 
double expel_priority = 7000.0; 
double chokepoint_priority = 1000.0; 
/// begin special unit bids  
// MODIFIERS   
    
    
// Raw Priority  
double max_threat_raw_bonus = 1000.0; 
double distance_from_home_priority_modifier = 500.0; 
double distance_from_enemy_priority_modifier = 250.0; 
double max_chokepoint_raw_bonus = 1000.0; 
double random_modifier = 10.0; 
double max_power_raw_bonus = 1000.0; 
double max_value_raw_bonus = 1000.0; 
double danger_diminishment = 0.5; 
double max_danger_raw_bonus = 1000.0; 
    
// Some city based goals will make the priority higher for bigger cities  
double per_capita_modifier = 500.0; 
    
// Some city based goals will make the priority higher closer threats  
double threat_proximity_modifier = 1000.0; 
    
// Unit specific modifiers  
double max_misc_bid_bonus = 1000.0; 
    
// modifier of raw priority computed by fuzzy system  
//  (1.0 = 100% of fuzzy system computed value)  
    
// If a particular type of goal prefers (but does not demand) some type  
// of unit, add this to the priority  
    
    
    
    
    
    
// FORCE MATCHING  
    
// MAX GOALS PER CITY  
//  
// These values are used for an AI team to define the maximum number of each  
// type of goal to consider in a given round.  The number is defined per city  
// in the empire, so if the empire had 10 cities, and MAX_ATTACK_GOALS was  
// 0.5, we'd only allow 5 attacks per round  
#define MAX_EVAL_DEFENSE_GOALS 2 
#define MAX_EVAL_SEIGE_GOALS 2 
#define MAX_EVAL_EXPLORE_GOALS -15 
#define MAX_EVAL_ENSLAVE_GOALS -25 
   
#define MAX_EXEC_SEIGE_GOALS -3 
#define MAX_EXEC_ENSLAVE_GOALS -4 
   
   
///////////////////////////////////////////////////////////////////////////////  
//  
// New Units Build List Stuff  
//  
///////////////////////////////////////////////////////////////////////////////  
//  
///////////////////////////////////////////////////////////////////////////////  
//  
// The Build Data  
//  
// This specifies a number of lists, from each of which EXACTLY ONE type of  
// unit will try to get built (in whatever quantity is specified)  
// Troops_Primary take precedence over Improvements and Wonders.  
// Troops_Core are interleaved with Improvements and Wonders. Wonders  
// score just over 8000, Improvements just under 8000. The Troops_Core  
// score is doubled for the first unit then bonus and given as is for the last  
// requested unit, so bids over 4000 drown out buildings for part of the build list.  
// Unit bids over 8000 drown out all buildings and wonders until fulfilled.  
Build_List_Class Build_List_Classes[MAX_BUILD_LISTS];  
