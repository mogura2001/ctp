		Abort();
		Message(g.tutorialplayer, 'MGoal1');	
	}

	DisableClose();

	Button(ID_BUTTON_NEXT_MESSAGE) {
		go = go + 1;
		Kill();
		Message(g.tutorialplayer, 'MTheTutorial');
	}
}


