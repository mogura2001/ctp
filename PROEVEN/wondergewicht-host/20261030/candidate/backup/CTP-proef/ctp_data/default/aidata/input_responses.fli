		tri yes_enough_me_giving_in_to_DEMAND_GOLD(
			enough_me_giving_in_to_DEMAND_GOLD, 1.0, 0.5)

	if(onceplus_i_said_yes_to_DEMAND_GOLD or once_i_said_yes_to_DEMAND_GOLD)
	{
		yes_enough_me_giving_in_to_DEMAND_GOLD
