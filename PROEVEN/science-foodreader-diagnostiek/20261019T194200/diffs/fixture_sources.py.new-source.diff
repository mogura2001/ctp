+ for branch,_,_ in BRANCHES:(folder/('edge-'+str(branch)+'.stage.bin')).write_bytes(seed(branch))
+ (folder/'edge-cases.json').write_text(json.dumps([dict(id=i,name=n,synthetic_edge_injection=True,natural_guard_reachability_proven=False,eflags=edge_flags(i),stage_file='edge-'+str(i)+'.stage.bin',expect=dict(return_EAX=0,out40_zero=True,stdcall_pop=20,instrument_GPR_EFLAGS_preserved=True,x87_unchanged=True,foreign_callbacks=0)) for i,_,n in BRANCHES],indent=2)+'\n','utf-8')
+ print('Prepared only 37 synthetic log-edge prestates plus finite normal caller; no native run')
+if __name__=='__main__':main()
