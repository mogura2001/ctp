+def seed(branch):
+ raw=bytearray(236)
+ def put(name,value):off,fmt,_=FIELDS[name];struct.pack_into('<'+fmt,raw,off,value)
+ values=dict(schema=1,valid=0,branch_id=0,callkind=1,owner=123,generation=7,prefix=3,ordinal=64,external=bytes(8),internal=bytes(8),width=1,height=1,world=0x12340000,pointer_parent=0x12340000,pointer_offset=0,pointer_value=0,cell=0x12340010,cityhandle=0,armyarray=0,unitcount=0,terrain=1,terrain_db=0x12340020,terrain_count=24,recordarray=0x12340030,mainrecord=0x12340040,chosenrecord=0x12340040,cellflags=0,rawgood=0,chosengood=0,basefood=5,road=0,irrigation=0,mine=0,river=0,canal=0,environment=0x12340050,sum_before=5,sum_after=5,native_called=0,native_return=1,output_before=-1,output_after=5,bonuspointer=0x12340060,bonus=0,center_before=5,center_after=5,failure_eflags=0,native_vtable=0x12340070,addend_stage=0,outpointer=0,bindingpointer=0,guard_a=0,guard_b=0)
+ if branch==1:values.update(internal=struct.pack('<hhhH',0,0,1,0),guard_a=1)
+ if branch in (2,3):values.update(internal=struct.pack('<hhhH',1 if branch==2 else 0,1 if branch==3 else 0,0,0),guard_a=1,guard_b=1)
+ if branch==9:values.update(cityhandle=7,guard_a=7)
+ if branch==10:values.update(armyarray=0x12340080,unitcount=1,guard_a=1)
+ if branch==8:values.update(cell=0)
+ if branch==11:values.update(terrain=-1,guard_a=0xffffffff,guard_b=23)
+ terrains={12:13,13:18,14:23,15:10,16:11,17:12,18:14,19:15,20:16,21:17}
+ if branch in terrains:values.update(terrain=terrains[branch],guard_a=terrains[branch],guard_b=terrains[branch])
+ if branch==23:values.update(terrain_count=1,guard_a=1,guard_b=1)
+ if branch==22:values.update(terrain_db=0)
+ if branch==24:values.update(recordarray=0)
+ if branch==25:values.update(cellflags=5<<6,rawgood=5,guard_a=5,guard_b=4)
+ if 26<=branch<=30:
+  values.update(addend_stage=branch-25,sum_before=0x7fffffffffffffff,sum_after=-0x8000000000000000,guard_a=0,guard_b=0x80000000)
+  values[('road','irrigation','mine','river','canal')[branch-26]]=1
+ if branch==31:values.update(sum_after=0x100000000,guard_a=0,guard_b=1)
+ if branch==32:values.update(sum_after=0x80000000,guard_a=0x80000000,guard_b=0)
+ if branch>=33:values.update(native_called=1)
+ if branch==33:values.update(native_return=0,output_after=-1,guard_a=0)
+ if branch==34:values.update(output_after=6,guard_a=6,guard_b=5)
+ if branch==35:values.update(addend_stage=6,bonus=1,center_before=0x7fffffffffffffff,center_after=-0x8000000000000000,guard_a=0,guard_b=0x80000000)
+ if branch==36:values.update(center_after=0x100000000,guard_a=0,guard_b=1)
+ if branch==37:values.update(center_after=0x80000000,guard_a=0x80000000,guard_b=0)
+ mask=sum(1<<b for b in required_bits(branch)-{37})
+ values.update(reached_lo=mask&0xffffffff,reached_hi=mask>>32)
+ for name,value in values.items():put(name,value)
+ return bytes(raw)
