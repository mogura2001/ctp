+ edge=finish(r,f)
+ r,f=start();r.op('pushfd',b'\x9c');r.op('pushad',b'\x60');r.mov('esi','esp');ptr(r,f,'observed GPR/flags own buffer','bf',0x800);r.mov('ecx',9);r.op('cld',b'\xfc');r.op('rep movsd',b'\xf3\xa5');r.op('popad',b'\x61');r.op('popfd',b'\x9d');ptr(r,f,'continue original food_bad wipe','ff25',12)
+ observer=finish(r,f)
+ r,f=start();r.prologue(560)
+ r.push(m('ebp',24));r.lea('eax',m('ebp',-184));r.push('eax');r.push(m('ebp',16));r.push(m('ebp',12));r.push(m('ebp',8))
+ ptr(r,f,'pinned SCI return address in own image','ff35',32);ptr(r,f,'real clone or original shared reader','ff25',36)
+ r.label('continuation');r.mov(m('ebp',-16),'eax');r.lea('esi',m('ebp',-184));r.mov('edi',m('ebp',20));r.mov('ecx',10);r.op('cld',b'\xfc');r.op('rep movsd',b'\xf3\xa5');r.mov('eax',m('ebp',-16));r.epilogue(560,20)
+ normal=finish(r,f)
+ return dict(edge=edge,observer=observer,normal=normal)
