+def recipes():
+ def start():return X86(),[]
+ def ptr(r,fix,text,op,off):r.emit(text,op+'00000000');fix.append(dict(at=len(r.code)-4,context_offset=off))
+ def finish(r,fix):return dict(code=r.finish(),recipe=r.rows,fixups=fix,labels=r.labels)
+ r,f=start();r.prologue(FRAME_SIZE)
+ ptr(r,f,'stage source','8b35',4);r.lea('edi',m('ebp',STAGING));r.mov('ecx',59);r.op('cld',b'\xfc');r.op('rep movsd',b'\xf3\xa5')
+ ptr(r,f,'own Plan','a1',0);r.mov(m('ebp',PLAN_SPILL),'eax');r.mov(m('ebp',ACTIVE),1);r.alu('add','eax',144);r.mov(m('ebp',STAGING+224),'eax')
+ r.mov('eax',m('ebp',20));r.mov(m('ebp',STAGING+220),'eax');r.mov('eax',m('ebp',8));r.mov(m('ebp',STAGING+60),'eax')
+ ptr(r,f,'expected entry ESP','8925',24);ptr(r,f,'expected entry EBP','892d',28)
