+def edge_flags(branch):
+ # Controlled synthetic flags satisfy the taken condition; no reachability claim.
+ flags=0x202
+ if branch in list(range(4,9))+list(range(12,22))+[22,24,33]:flags|=0x40
+ if branch in (32,37):flags|=0x80
+ if branch in (26,27,28,29,30,35):flags|=0x800
+ return flags
