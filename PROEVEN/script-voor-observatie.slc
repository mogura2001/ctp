////New Stuff////
trigger 'InitializeRoomUpgrades' when (IsHumanPlayer(g.player) && (g.year == 0)) {
	numberOfUpgradesAvailable = 5;
	savedThroneRoomScore = player.score;
	throneRoomUpgradeAt = (g.maxscore-player.score)/35;
      AgeYear = 0;
}

trigger 'AgeChangeForThroneRoom' when (IsHumanPlayer(g.player) && special.agechange) {
	numberOfUpgradesAvailable = numberOfUpgradesAvailable + 5;
      AgeYear = g.year;
}

trigger 'ThroneRoomUpgrade' when (IsHumanPlayer(g.player) && ((player.score - savedThroneRoomScore) > throneRoomUpgradeAt) && (numberOfUpgradesAvailable > 0) && (g.year >= AgeYear) ) {
	numberOfUpgradesAvailable = numberOfUpgradesAvailable - 1;
	savedThroneRoomScore = savedThroneRoomScore + throneRoomUpgradeAt;
      AgeYear = g.year + 7;
	OpenThroneRoom();
}


