messagebox 'TradeBidSetPrice' {
	MessageType("TRADE");
	Text(ID_TRADE_BID_SET_PRICE);
	EyeDropdown(1, city);

	Button(ID_BUTTON_CANCEL) {
		Kill();
	}
	Button(ID_BUTTON_SET_PRICE) {
		SendTradeBid();
	}	
}

messagebox 'TradeBid' {
	MessageType("TRADE");
	Text(ID_TRADE_BID);
	EyeDropdown(1, city);
	Button(ID_BUTTON_ACCEPT) {
