messagebox '28PickNewDiscovery' {
	Text(ID_PICK_NEW_DISCOVERY);
	// discovery.1 is what was just discovered.  So the dropdown starts at discovery.2.
	EyeDropdown(2, discovery);
	Button(ID_BUTTON_RESEARCH) {
		Research();
		Kill();
	}
	Button(ID_BUTTON_LIBRARY) {
		OpenLibrary();
	}

	Button(ID_BUTTON_GOAL) {
		OpenResearchGoalWindow();
	}
	MessageType("KNOWLEDGE");
}

