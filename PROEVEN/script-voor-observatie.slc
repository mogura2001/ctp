alertBox '110CantAttackAllies' {
	if(AllUnitsCanBeExpelled(location.1)) {
		Text(ID_CANT_ATTACK_ALLIES_CAN_EXPEL);
	} else {
		Text(ID_CANT_ATTACK_ALLIES);
	}

	MessageType("DIPLOMATIC");
	

	Button(ID_BUTTON_NO) {
		ClearOrders(unit.1);
		Kill();
	}

	Button(ID_BUTTON_YES) {
		BreakAlliance(player.1);
		AddOrder(unit.1, location.1);
		Kill();
	}

	if(AllUnitsCanBeExpelled(location.1)) {
		Button(ID_BUTTON_EXPEL) {
			AddExpelOrder(unit.1, location.1);
			Kill();
		}
	}
}

