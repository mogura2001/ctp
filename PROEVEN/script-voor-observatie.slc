messagebox '48WorldPollutionSpaceLaunch' {
	if (space_launch_count == 9) {
		space_launch_count = 0;
		MessageType("POLLUTION");
		Text(ID_WORLD_POLLUTION_SPACE_LAUNCH) ;
        } else {
		space_launch_count = space_launch_count + 1;
		Abort();
	}
}

