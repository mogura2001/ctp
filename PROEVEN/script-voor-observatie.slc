alertBox '14IAAutoUnload' {
	MessageClass(420);
	if(!played_auto_unload_message) {
		Text(ID_IA_AUTO_UNLOAD);
		Button(ID_BUTTON_NO) {
			DoAutoUnload(location.1, 0);
			Kill();
		}
		Button(ID_BUTTON_YES) {
			DoAutoUnload(location.1, 1);
			played_auto_unload_message = 1;
			Kill();
		}
	} else {
		DoAutoUnload(location.1, 1);
		Abort();
	}
}

